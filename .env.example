# =============================================================================
# Service Desk PM.11 — Environment variables (copy to .env and fill in)
# NEVER commit real passwords to git!
# =============================================================================

# PostgreSQL
POSTGRES_USER=dba_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=servicedesk
POSTGRES_PORT=5432

# OpenLDAP
LDAP_ADMIN_PASSWORD=change_me_ldap_password
LDAP_DOMAIN=corp.local
LDAP_ORGANIZATION="Vector-Prom"

# Mail (docker-mailserver)
MAILSERVER_HOSTNAME=mail.corp.local
MAILSERVER_ADMIN_PASSWORD=change_me_mail_password
SMTP_PORT=25
IMAP_PORT=143
SMTP_HOST=mail
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@corp.local
SMTP_STARTTLS=0
NOTIFIER_POLL_SECONDS=5

# Application roles (each service connects with its own role)
APP_SERVICE_PASSWORD=change_me_app_service
MIGRATOR_PASSWORD=change_me_migrator
DIRSYNC_PASSWORD=change_me_dirsync
NOTIFIER_PASSWORD=change_me_notifier
MAILINTAKE_PASSWORD=change_me_mailintake

# pgcrypto key (passed by application, NOT stored in DB)
PGCRYPTO_KEY=change_me_32_char_key_here

# Timezone
TZ=Europe/Moscow

SVC_NOTIFIER_PASSWORD=<set-in-production>
SVC_MAILINTAKE_PASSWORD=<set-in-production>
SVC_DIRSYNC_PASSWORD=<set-in-production>
